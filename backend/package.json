{
  "name": "backend",
  "version": "1.0.0",
  "description": "Hoovik backend API",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "prod": "pm2 start ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "stop": "pm2 delete all",
    "deploy": "pm2 delete all || true && pm2 start ecosystem.config.cjs --update-env && pm2 save && pm2 list",
    "test:redis": "node tests/integration/redis.test.js",
    "test:redis:ci": "SKIP_RECOVERY_TESTS=true node tests/integration/redis.test.js",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "author": "Anupam Kumar",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.6",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "form-data": "^4.0.4",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5",
    "http-status": "^1.7.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^5.11.0",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.7.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "vitest": "^3.2.7"
  }
}
